# ---------- App ----------
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
APP_PORT=6651
WIDGET_BASE_URL=http://localhost:6651

# ---------- MongoDB ----------
# When running via docker-compose, this is overridden to mongodb://mongo:27017/recepta
MONGO_URI=mongodb://localhost:27017/recepta
MONGO_DB_NAME=recepta

# ---------- Supabase Storage (PDFs, docs, greeting audio) ----------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=recepta-files

# ---------- LLM provider ----------
# One of: groq | mistral | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ---------- Voice ----------
DEEPGRAM_API_KEY=
TTS_PROVIDER=sarvam
TTS_API_KEY=

# ---------- Embeddings ----------
# "local" ships a built-in embedder so RAG works with zero external keys.
EMBEDDING_PROVIDER=local

# ---------- Crawler limits ----------
CRAWL_MAX_URLS=40
CRAWL_MAX_DEPTH=2
CRAWL_TIMEOUT_SECONDS=8

# ---------- Seed script (optional) ----------
SEED_ADMIN_EMAIL=admin@recepta.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_ORG=ABC Heating & Air
SEED_DEMO_OWNER_EMAIL=owner@abcheating.local
SEED_DEMO_OWNER_PASSWORD=ChangeMe123!
